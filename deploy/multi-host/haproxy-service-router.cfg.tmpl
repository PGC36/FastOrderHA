backend delivery_service_backends
    balance roundrobin
    default-server inter 3s fall 2 rise 1
    server node1 ${FASTORDER_APP_NODE_1_IP}:8085 check
    server node2 ${FASTORDER_APP_NODE_2_IP}:8085 check
    server node3 ${FASTORDER_APP_NODE_3_IP}:8085 check

backend notification_service_backends
