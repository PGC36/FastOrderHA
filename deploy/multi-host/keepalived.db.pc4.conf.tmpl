vrrp_script chk_db_proxy {
    script "curl -fsS http://127.0.0.1:7000/stats > /dev/null"
    interval 2
    timeout 2
    fall 2
    rise 1
}

vrrp_instance VI_FASTORDER_DB {
    state BACKUP
    interface ${DB_KEEPALIVED_INTERFACE}
    virtual_router_id ${DB_KEEPALIVED_ROUTER_ID}
    priority ${DB_KEEPALIVED_PC4_PRIORITY}
    advert_int 1
    authentication {
        auth_type PASS
        auth_pass ${DB_KEEPALIVED_AUTH_PASS}
    }
    virtual_ipaddress {
        ${DB_PROXY_VIP}/24
    }
    track_script {
        chk_db_proxy
    }
}
