scope: fastorder-cluster
namespace: /service/
name: ${FASTORDER_PATRONI_NAME}

restapi:
  listen: 0.0.0.0:8008
  connect_address: ${FASTORDER_NODE_IP}:${FASTORDER_PATRONI_API_PORT}

etcd3:
  hosts: ${FASTORDER_ETCD_HOSTS}

bootstrap:
  dcs:
    ttl: 30
    loop_wait: 10
    retry_timeout: 10
    maximum_lag_on_failover: 1048576
    postgresql:
      use_pg_rewind: true
      use_slots: true
      pg_hba:
        - local all all trust
        - host all all 127.0.0.1/32 trust
        - host all all 0.0.0.0/0 md5
        - host replication replicator 0.0.0.0/0 md5
      parameters:
        wal_level: replica
        hot_standby: "on"
        max_wal_senders: 10
        max_replication_slots: 10
        wal_keep_size: 512MB
        max_connections: 300
  initdb:
    - encoding: UTF8
    - data-checksums
  post_bootstrap: /bin/sh /scripts/post-bootstrap.sh

postgresql:
  listen: 0.0.0.0:5432
  connect_address: ${FASTORDER_NODE_IP}:${FASTORDER_POSTGRES_PORT}
  data_dir: /var/lib/postgresql/data/pgdata
  bin_dir: /usr/lib/postgresql/17/bin
  pgpass: /tmp/pgpass
  authentication:
    superuser:
      username: postgres
      password: ${FASTORDER_POSTGRES_PASSWORD}
    replication:
      username: replicator
      password: ${FASTORDER_REPLICATION_PASSWORD}
    rewind:
      username: postgres
      password: ${FASTORDER_POSTGRES_PASSWORD}
  parameters:
    unix_socket_directories: /var/run/postgresql

tags:
  nofailover: false
  noloadbalance: false
  clonefrom: false
  nosync: false
