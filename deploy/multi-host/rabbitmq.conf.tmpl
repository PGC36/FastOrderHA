listeners.tcp.default = 5672
management.tcp.port = 15672
prometheus.tcp.port = 15692

cluster_partition_handling = autoheal
queue_master_locator = min-masters

cluster_formation.peer_discovery_backend = classic_config
cluster_formation.classic_config.nodes.1 = rabbit@${RABBITMQ_NODE_1_NAME}
cluster_formation.classic_config.nodes.2 = rabbit@${RABBITMQ_NODE_2_NAME}
cluster_formation.classic_config.nodes.3 = rabbit@${RABBITMQ_NODE_3_NAME}
