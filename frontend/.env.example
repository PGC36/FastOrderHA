# URL base del API Gateway (por defecto: local dev)
VITE_API_BASE_URL=http://localhost:8080

# URLs de herramientas de observabilidad (opcionales, usadas en /admin)
VITE_GRAFANA_URL=http://localhost:3000
VITE_RABBITMQ_UI_URL=http://localhost:15672
VITE_PROMETHEUS_URL=http://localhost:9090

# Activar datos mock para desarrollo sin backend
# Setear a "false" cuando el backend esté corriendo
VITE_USE_MOCKS=true
